{
  "rewrites": [
    {
      "source": "/((?!api|\\.well-known).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/matrix/(client|server)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
